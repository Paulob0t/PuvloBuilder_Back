generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("super_admins")
}

model Project {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String?             @db.Text
  published   Boolean             @default(false)
  blocks      String              @db.LongText
  settings    String?             @db.LongText
  authEnabled Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  routePrefix String              @default("sitio")
  submissions ProjectSubmission[]
  users       ProjectUser[]
  clients     Client[]

  @@map("projects")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  status    String   @default("active") // "active", "lead", "inactive"
  notes     String?  @db.Text
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("clients")
}

model ProjectUser {
  id        String   @id @default(cuid())
  projectId String
  email     String
  password  String
  name      String
  role      String   @default("admin")
  metadata  String?  @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([projectId])
  @@map("project_users")
}

model ProjectSubmission {
  id        String   @id @default(cuid())
  projectId String
  formId    String?
  data      String   @db.LongText
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_submissions")
}
